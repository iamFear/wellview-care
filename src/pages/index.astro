---
import '../styles/global.css';

const services = [
  {
    number: '01',
    title: 'Prevent HIV',
    text: 'PrEP helps prevent HIV before exposure. PEP may help after a possible exposure and should be started within 72 hours.',
    image: '/assets/service-prevention.webp',
    alt: '',
    href: 'https://wellviewcare.org/services/prep',
  },
  {
    number: '02',
    title: 'Get tested',
    text: 'Private testing for HIV, hepatitis C, chlamydia, gonorrhea, syphilis, and other infections. Some results are ready in about 30 minutes.',
    image: '/assets/service-testing.webp',
    alt: '',
    href: 'https://wellviewcare.org/services/sti',
  },
  {
    number: '03',
    title: 'Start treatment',
    text: 'If a test is positive, we explain the result in plain language and build a treatment plan that fits your health and your life.',
    image: '/assets/service-treatment.webp',
    alt: '',
    href: 'https://wellviewcare.org/services/hiv',
  },
];

const careGuides = [
  {
    label: 'HCV treatment',
    title: 'How is hepatitis C treated?',
    text: 'Hepatitis C can spread through blood-to-blood or sexual contact and may cause serious liver damage when it is not treated. After a confidential rapid test—with results available in about 30 minutes—our team creates a personal treatment plan.',
    fact: 'WellView Care uses EPCLUSA® as its preferred treatment: one pill each day, with a reported 98% cure rate over 12 weeks.',
    href: 'https://wellviewcare.org/services/hep-c',
  },
  {
    label: 'HIV treatment',
    title: 'How is HIV treated?',
    text: 'Without treatment, HIV can progress to AIDS and leave the body less able to fight common infections. After a confidential rapid test, we explain the result and create a personal care plan with you.',
    fact: 'Support can include BIKTARVY®—WellView Care’s preferred treatment—and anonymous notification of recent contacts.',
    href: 'https://wellviewcare.org/services/hiv',
  },
  {
    label: 'STI / STD treatment',
    title: 'How are STIs and STDs treated?',
    text: 'You can visit because you have symptoms, a recent contact told you about an exposure, or you simply want regular testing. We test for chlamydia, gonorrhea, syphilis, and other common infections.',
    fact: 'If treatment is needed, you receive counseling, practical education, a personal treatment plan, and continued support.',
    href: 'https://wellviewcare.org/services/sti',
  },
  {
    label: 'HIV prevention',
    title: 'How do PrEP and PEP work?',
    text: 'PrEP is a daily medicine that can lower the chance of getting HIV for people with a higher risk, including through needle sharing or sex without a condom. PEP is for a possible recent exposure.',
    fact: 'PEP must be started within 72 hours of a possible exposure. Contact the clinic as soon as possible so the team can guide you.',
    href: 'https://wellviewcare.org/services/prep',
  },
];

const locations = [
  { city: 'Fort Lauderdale', address: '906 W Sunrise Blvd Suite A, Fort Lauderdale, FL 33311', phone: '844-650-2626', tel: '+18446502626', email: 'office@wellviewcare.org' },
  { city: 'Fort Pierce', address: '2708 S US Hwy 1, Fort Pierce, FL 34982', phone: '772-310-4250', tel: '+17723104250', email: 'office.fp@wellviewcare.org' },
  { city: 'Jacksonville', address: '1128 N Laura St, Jacksonville, FL 32206', phone: '904-867-7968', tel: '+19048677968', email: 'office.jax@wellviewcare.org' },
  { city: 'Riviera Beach', address: '3514 Broadway, Riviera Beach, FL 33403', phone: '561-821-4345', tel: '+15618214345', email: 'office.rv@wellviewcare.org' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Confidential HIV, HCV, and STI testing, prevention, and treatment from WellView Care across Florida." />
    <meta name="theme-color" content="#fff6e9" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <title>WellView Care | Confidential Testing & Treatment in Florida</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>

    <header class="site-header" aria-label="Primary navigation">
      <a class="brand" href="#top" aria-label="WellView Care home">
        <img src="/assets/wellview-logo.webp" width="154" height="57" alt="WellView Care" />
      </a>
      <nav class="desktop-nav" aria-label="Main menu">
        <a href="#services">Services</a>
        <a href="#process">Our process</a>
        <a href="#about">About</a>
        <a href="#locations">Locations</a>
      </nav>
      <a class="button button-small" href="/appointment/">Book an appointment</a>
      <details class="mobile-menu">
        <summary aria-label="Open navigation"><span></span><span></span></summary>
        <nav aria-label="Mobile menu">
          <a href="#services">Services</a><a href="#process">Our process</a><a href="#about">About</a><a href="#locations">Locations</a>
          <a href="/appointment/">Book an appointment</a>
        </nav>
      </details>
    </header>

    <main id="main">
      <section class="hero" id="top" aria-labelledby="hero-title">
        <div class="hero-media" aria-hidden="true">
          <img src="/assets/clinic-lab.webp" width="320" height="286" alt="" fetchpriority="high" />
        </div>
        <div class="hero-orbit orbit-one"></div>
        <div class="hero-orbit orbit-two"></div>
        <div class="hero-content">
          <p class="eyebrow">Welcome to WellView Care · Southeast Florida’s trusted STD testing and treatment clinic</p>
          <h1 id="hero-title">TESTING.<br /><span>TREATMENT.</span><br />SUPPORT.</h1>
          <p class="hero-copy">Confidential HIV, hepatitis C, and STI care from people who listen. Insurance is not required.</p>
          <div class="hero-actions">
            <a class="button" href="/appointment/">Book an appointment <span aria-hidden="true">↗</span></a>
            <a class="text-link" href="tel:+18665025545">Call 866-502-5545 <span aria-hidden="true">↗</span></a>
          </div>
        </div>
        <div class="hero-stat hero-stat-results"><strong>~30 min</strong><span>some rapid results</span></div>
        <div class="hero-stat hero-stat-locations"><strong>4 clinics</strong><span>across Florida</span></div>
        <div class="hero-note" aria-hidden="true"><span>501(c)(3)</span> nonprofit care</div>
      </section>

      <section class="trust-strip" aria-label="WellView Care highlights">
        <div><span aria-hidden="true">●</span><strong>Confidential care</strong></div>
        <div><span aria-hidden="true">●</span><strong>Insurance not required</strong></div>
        <div><span aria-hidden="true">●</span><strong>Clear next steps</strong></div>
        <div><span aria-hidden="true">●</span><strong>Four Florida clinics</strong></div>
      </section>

      <section class="intro section-pad" aria-labelledby="intro-title">
        <div class="section-label"><span>What we believe</span><span>01</span></div>
        <div class="intro-grid">
          <h2 id="intro-title">Not sure what you need? Start here.</h2>
          <div class="intro-copy">
            <p>Tell us what is happening. Our team will help you choose the right test, prevention option, or treatment—privately and without judgment.</p>
            <a class="arrow-link" href="/appointment/">Choose a clinic and visit type <span aria-hidden="true">↗</span></a>
          </div>
        </div>
      </section>

      <section class="services section-pad" id="services" aria-labelledby="services-title">
        <div class="section-label light"><span>Holistic support</span><span>02</span></div>
        <div class="section-heading-row">
          <h2 id="services-title">Choose what<br />you need today.</h2>
          <p>Each visit starts with a private conversation. We explain your options before any test or treatment.</p>
        </div>
        <div class="service-list">
          {services.map((service) => (
            <article class="service-card">
              <div class="service-image">
                <img src={service.image} alt={service.alt} loading="lazy" decoding="async" />
              </div>
              <span class="service-number">{service.number}</span>
              <div class="service-content">
                <h3>{service.title}</h3>
                <p>{service.text}</p>
              </div>
              <a href={service.href} aria-label={`Learn more about ${service.title}`}><span aria-hidden="true">↗</span></a>
            </article>
          ))}
        </div>
      </section>

      <section class="treatments" aria-labelledby="treatment-title">
        <div class="treatment-visual">
          <img src="/assets/about-wellview.webp" width="380" height="380" alt="Medical illustration of a liver supported by gloved hands" loading="lazy" decoding="async" />
          <div class="color-dot dot-a"></div><div class="color-dot dot-b"></div><div class="color-dot dot-c"></div>
        </div>
        <div class="treatment-copy">
          <p class="eyebrow dark">Personalized treatment</p>
          <h2 id="treatment-title">Tested.<br />Treated.<br /><span>Supported.</span></h2>
          <p>Some rapid tests give results in about 30 minutes. If you need treatment, we explain the result, answer your questions, and stay with you through the next steps.</p>
          <div class="treatment-facts" aria-label="Treatment highlights">
            <div><strong>Private</strong><span>Your visit and results</span></div>
            <div><strong>Simple</strong><span>Answers you can understand</span></div>
          </div>
          <a class="button button-dark" href="/appointment/">Plan your visit</a>
        </div>
      </section>

      <section class="care-guide section-pad" id="care-guide" aria-labelledby="care-guide-title">
        <div class="section-label"><span>Understand your care</span><span>03</span></div>
        <div class="guide-heading">
          <h2 id="care-guide-title">Clear answers about prevention and treatment.</h2>
          <p>These are the main conditions and prevention options WellView Care supports. Your care team will explain what applies to you.</p>
        </div>
        <div class="guide-grid">
          {careGuides.map((guide, index) => (
            <article class="guide-card">
              <div class="guide-card-top"><span>0{index + 1}</span><p>{guide.label}</p></div>
              <h3>{guide.title}</h3>
              <p>{guide.text}</p>
              <div class="guide-fact"><span aria-hidden="true">✓</span><p>{guide.fact}</p></div>
              <a href={guide.href}>Learn more about {guide.label} <span aria-hidden="true">↗</span></a>
            </article>
          ))}
        </div>
      </section>

      <section class="process section-pad" id="process" aria-labelledby="process-title">
        <div class="section-label"><span>What to expect</span><span>04</span></div>
        <div class="process-grid">
          <div>
            <p class="eyebrow dark">Three steps to care</p>
            <h2 id="process-title">A clear path forward.</h2>
          </div>
          <ol class="steps">
            <li><span>01</span><div><h3>Insurance confirmation</h3><p>Health insurance is not required. Before testing or treatment, we check whether you have coverage and explain your options.</p></div></li>
            <li><span>02</span><div><h3>Financial aid</h3><p>WellView Care is a dedicated 501(c)(3) nonprofit organization. Our team can help you apply for financial assistance.</p></div></li>
            <li><span>03</span><div><h3>Tailored treatment</h3><p>After thorough testing, we create a personal treatment plan and give you condition-specific education and support.</p></div></li>
          </ol>
        </div>
      </section>

      <section class="about section-pad" id="about" aria-labelledby="about-title">
        <div class="about-word" aria-hidden="true">WELL</div>
        <div class="about-inner">
          <p class="eyebrow">About WellView Care</p>
          <h2 id="about-title">Care you can understand. Support you can trust.</h2>
          <div class="about-columns">
            <p>WellView Care serves Southeast Florida and makes quality care accessible regardless of insurance status. Our goal is to help every patient understand their health and thrive.</p>
            <ul>
              <li>Fast, accurate rapid tests and labs for HIV, HCV, and common STIs / STDs</li>
              <li>Tailored education, resources, and counseling with useful next steps</li>
              <li>Anonymous notifications for recent contacts, handled for you</li>
              <li>HIV prevention with PrEP and PEP</li>
              <li>Answers to your questions from experienced medical staff</li>
              <li>Additional support based on your needs</li>
            </ul>
          </div>
        </div>
      </section>

      <section class="locations section-pad" id="locations" aria-labelledby="locations-title">
        <div class="section-label"><span>Find your clinic</span><span>05</span></div>
        <div class="section-heading-row locations-heading">
          <h2 id="locations-title">Care across<br />Florida.</h2>
          <a class="phone-callout" href="tel:+18665025545"><span>Central line</span><strong>866-502-5545</strong></a>
        </div>
        <p class="locations-intro">We are committed to providing quality care for the communities we serve throughout Fort Lauderdale, Fort Pierce, Jacksonville, and Riviera Beach.</p>
        <div class="location-grid">
          {locations.map((location, index) => (
            <article class="location-card">
              <span>0{index + 1}</span>
              <h3>{location.city}</h3>
              <address>{location.address}</address>
              <div><a href={`tel:${location.tel}`}>{location.phone}</a><a href={`mailto:${location.email}`}>{location.email}</a></div>
            </article>
          ))}
        </div>
      </section>

      <section class="final-cta" aria-labelledby="cta-title">
        <div class="cta-mark" aria-hidden="true"></div>
        <p class="eyebrow">Take the next step</p>
        <h2 id="cta-title">Your care.<br />Your privacy.<br /><span>Your move.</span></h2>
        <div class="hero-actions centered">
          <a class="button button-white" href="/appointment/">Book an appointment <span aria-hidden="true">↗</span></a>
          <a class="text-link" href="https://wellviewcare.org/contact">Contact us</a>
        </div>
      </section>
    </main>

    <footer>
      <a href="#top"><img src="/assets/wellview-logo.webp" width="154" height="57" alt="WellView Care" loading="lazy" /></a>
      <div class="footer-links"><a href="#services">Services</a><a href="/appointment/">Book an appointment</a><a href="#locations">Locations</a><a href="#about">About</a><a href="https://wellviewcare.org/gallery">Gallery</a><a href="https://wellviewcare.org/blog">Blog</a><a href="https://wellviewcare.org/contact">Contact</a><a href="https://wellviewcare.org/faq">FAQ</a><a href="https://wellviewcare.org/donate">Donate</a></div>
      <p>© {new Date().getFullYear()} WellView Care. All rights reserved.</p>
    </footer>
  </body>
</html>
